{
  "name": "aether",
  "version": "1.0.9",
  "description": "Aether — AI desktop agent. BYOK, multi-provider, fully local.",
  "main": "out/main/index.js",
  "homepage": "./",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "rebuild-native": "node scripts/patch-pty-gyp.js && electron-rebuild -f -w @homebridge/node-pty-prebuilt-multiarch",
    "postinstall": "node scripts/patch-pty-gyp.js && electron-rebuild -f -w @homebridge/node-pty-prebuilt-multiarch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "build": {
    "appId": "com.srbvik92.aether",
    "productName": "Aether",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "out"
    },
    "files": [
      "out/**/*",
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.*}",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "win": {
      "executableName": "aether",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "srbvik92",
      "repo": "aether",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@google-cloud/vertexai": "^1.11.0",
    "@google/genai": "^1.49.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/diff": "^7.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "diff": "^8.0.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.55.1",
    "mysql2": "^3.22.2",
    "openai": "^4.77.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^11.0.0",
    "pg": "^8.13.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^2.4.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.6.0"
  }
}
